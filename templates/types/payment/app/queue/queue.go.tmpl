package queue

import (
	"context"
	"database/sql"
	"fmt"
	"os"
	"sort"
	"strconv"
	"strings"

	"{{ .ModuleName }}/app/constants"
	"github.com/choplife-group/go-utils/connection"
	"github.com/redis/go-redis/v9"
	"github.com/sirupsen/logrus"
	"go.opentelemetry.io/otel/trace"
)

type Queue struct {
	RabbitMQ  *connection.RabbitMQ
	DB        *sql.DB
	RedisConn *redis.Client
	Tracer    trace.Tracer
}

// InitQueues starts the consumers for every queue listed in QUEUES, e.g.
// QUEUES=withdraw,deposit. <queue>_workers sets how many consumers a queue gets
// (default 1). QUEUE_PREFIX is applied by go-utils, so list the bare names.
//
// It returns once the consumers are started. Each one runs until the
// connection is closed, re-declaring its queue and resuming whenever the
// broker comes back.
func (q *Queue) InitQueues(ctx context.Context) {

	parts := strings.Split(os.Getenv("QUEUES"), ",")
	sort.Strings(parts)

	for _, name := range parts {

		name = strings.ToLower(strings.TrimSpace(name))

		// strings.Split yields one empty element for an empty QUEUES
		if name == "" {
			continue
		}

		workers, err := strconv.Atoi(os.Getenv(fmt.Sprintf("%s_workers", name)))
		if err != nil || workers < 1 {
			workers = 1
		}

		cfg := connection.RabbitMQConsumerConfig{
			Queue:         name,
			PrefetchCount: 1,
			MaxPriority:   5,
		}

		for i := 0; i < workers; i++ {

			go q.consume(ctx, cfg)
		}

		logrus.WithContext(ctx).
			WithFields(logrus.Fields{
				constants.DESCRIPTION: "started consumers",
				constants.DATA:        q.RabbitMQ.QueueName(name),
			}).
			Infof("%d worker(s)", workers)
	}
}

func (q *Queue) consume(ctx context.Context, cfg connection.RabbitMQConsumerConfig) {

	if err := q.RabbitMQ.ConsumeWithContext(ctx, cfg, q.Handler(cfg.Queue)); err != nil {

		logrus.WithContext(ctx).
			WithFields(logrus.Fields{
				constants.DESCRIPTION: "consumer stopped",
				constants.DATA:        cfg.Queue,
			}).
			Error(err.Error())
	}
}
