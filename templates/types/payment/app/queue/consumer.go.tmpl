package queue

import (
	"context"

	"{{ .ModuleName }}/app/constants"
	"github.com/choplife-group/go-utils/connection"
	amqp "github.com/rabbitmq/amqp091-go"
	"github.com/sirupsen/logrus"
)

// Handler returns the handler for one queue, named without QUEUE_PREFIX.
//
// Returning nil acknowledges the message; returning an error rejects it. A
// panic in a handler is recovered by go-utils and treated as an error.
func (q *Queue) Handler(queue string) connection.RabbitMQHandler {

	// TODO: dispatch each queue to its handler
	//
	//	switch queue {
	//	case "withdraw":
	//		return q.ProcessWithdrawal
	//	}

	return func(ctx context.Context, delivery amqp.Delivery) error {

		logrus.WithContext(ctx).
			WithFields(logrus.Fields{
				constants.DESCRIPTION: "no handler registered for queue",
				constants.DATA:        queue,
			}).
			Warn("message dropped")

		return nil
	}
}
