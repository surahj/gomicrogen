package controllers

import (
	"database/sql"

	"github.com/choplife-group/go-utils/connection"
	"github.com/redis/go-redis/v9"
	trace "go.opentelemetry.io/otel/trace"
)

type Controller struct {
	DB              *sql.DB
	RedisConn       *redis.Client
	GlobalRedisConn *redis.Client
	Tracer          trace.Tracer

	// RabbitMQ publishes to other services' queues, e.g.
	//
	//	err := controller.RabbitMQ.PublishWithContext(ctx, "reports-service.deposit.create", payload, 0)
	//
	// The queue name is used as given; QUEUE_PREFIX is not applied.
	RabbitMQ *connection.RabbitMQ
}
