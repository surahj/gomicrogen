{{ if .IsPostgres -}}
package database

import (
	"context"
	"database/sql"
	"fmt"
	"os"
	"strconv"
	"time"

	_ "github.com/lib/pq"
	"github.com/uptrace/opentelemetry-go-extra/otelsql"
	semconv "go.opentelemetry.io/otel/semconv/v1.4.0"
)

// Driver is the SQL dialect this service was generated for. Pass it to
// goutils.Db{Dialect: database.Driver} so placeholders and RETURNING are
// rendered correctly.
const Driver = "postgres"

// OpenFromEnvWithContext opens the service's Postgres database from the
// DATABASE_* variables and verifies it with a ping.
//
// MySQL services get this from go-utils (connection.OpenDatabaseFromEnv), which
// does not speak Postgres yet. This file mirrors it, reading the same variables
// and returning an error rather than a half-open pool, so it can be swapped for
// go-utils once Postgres is supported there.
func OpenFromEnvWithContext(ctx context.Context) (*sql.DB, error) {

	host := os.Getenv("DATABASE_HOST")
	port := os.Getenv("DATABASE_PORT")
	username := os.Getenv("DATABASE_USERNAME")
	password := os.Getenv("DATABASE_PASSWORD")
	dbname := os.Getenv("DATABASE_NAME")

	switch {
	case host == "":
		return nil, fmt.Errorf("database: host not configured")
	case port == "":
		return nil, fmt.Errorf("database: port not configured")
	case username == "":
		return nil, fmt.Errorf("database: username not configured")
	case dbname == "":
		return nil, fmt.Errorf("database: name not configured")
	}

	sslMode := os.Getenv("DATABASE_SSL_MODE")
	if sslMode == "" {
		sslMode = "disable"
	}

	dsn := fmt.Sprintf("host=%s port=%s user=%s password=%s dbname=%s sslmode=%s",
		host, port, username, password, dbname, sslMode)

	db, err := otelsql.Open(Driver, dsn,
		otelsql.WithAttributes(semconv.DBSystemPostgreSQL),
		otelsql.WithDBName(dbname))
	if err != nil {
		return nil, fmt.Errorf("database: open %s@%s:%s/%s: %w", username, host, port, dbname, err)
	}

	lifetime := time.Second * time.Duration(envInt("DATABASE_CONNECTION_LIFETIME", 60))

	db.SetMaxIdleConns(envInt("DATABASE_IDLE_CONNECTION", 5))
	db.SetMaxOpenConns(envInt("DATABASE_MAX_CONNECTION", 10))
	db.SetConnMaxLifetime(lifetime)
	db.SetConnMaxIdleTime(lifetime)

	pingCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
	defer cancel()

	if err := db.PingContext(pingCtx); err != nil {

		db.Close()

		return nil, fmt.Errorf("database: ping %s@%s:%s/%s: %w", username, host, port, dbname, err)
	}

	otelsql.ReportDBStatsMetrics(db)

	return db, nil
}

func envInt(name string, def int) int {

	value, err := strconv.Atoi(os.Getenv(name))
	if err != nil || value <= 0 {
		return def
	}

	return value
}
{{- end }}
