package router

import (
	"fmt"
	"net/http"

	"github.com/choplife-group/go-utils/connection"
	"github.com/labstack/echo/v4"
)

func (a *App) GetStatus(c echo.Context) error {

	ctx := c.Request().Context()

	status := make(map[string]interface{})

	statusCode := http.StatusOK

	// ping the pools the app already holds rather than opening new ones
	if err := connection.PingDatabaseWithContext(ctx, a.DB); err != nil {

		status["database"] = fmt.Sprintf("database error - %s", err.Error())
		statusCode = http.StatusInternalServerError

	} else {

		status["database"] = "database - sent successful ping"
	}

	if err := connection.PingRedisWithContext(ctx, a.RedisConn); err != nil {

		status["redis"] = fmt.Sprintf("redis error - %s", err.Error())
		statusCode = http.StatusInternalServerError

	} else {

		status["redis"] = "PONG"
	}

	// Add service status
	status["service"] = "healthy"
	status["service-name"] = "{{ .ServiceName }}"

	return c.JSON(statusCode, status)
}
